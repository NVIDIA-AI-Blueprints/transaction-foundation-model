{
  "name": "@loom/cli",
  "version": "0.1.0",
  "description": "Loom — standalone agentic data-science CLI, hosted on the Pi agent harness (drives the Python Loom engine via verb tools).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "loom": "bin/loom.js"
  },
  "files": [
    "bin/",
    "dist/",
    "extensions/",
    "prompts/",
    "home/"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:ext": "tsc -p tsconfig.extensions.json",
    "start": "node bin/loom.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.79.0",
    "@earendil-works/pi-ai": "0.79.0",
    "@sinclair/typebox": "0.34.49"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
