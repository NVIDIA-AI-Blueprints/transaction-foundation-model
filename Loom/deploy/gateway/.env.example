# Loom gateway runtime environment — COPY to `.env` and fill in REAL values.
#
#   cp deploy/gateway/.env.example deploy/gateway/.env
#
# The real `.env` holds secrets (the vendor key + the caller allowlist) and is
# gitignored — NEVER commit it. The gateway reads these at process start; none of
# them are ever baked into the image or written to the call log.

# REQUIRED — the REAL upstream vendor key the gateway forwards with. Stays on the
# server; callers never see it.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# REQUIRED — the allowlist of Loom keys callers must present (comma-separated).
# A caller authenticates with one of these (as `x-api-key` or `Authorization:
# Bearer`); anything else is rejected with 401 before any upstream forward.
LOOM_API_KEYS=loom-REPLACE_ME_1,loom-REPLACE_ME_2

# OPTIONAL — instead of (or in addition to) LOOM_API_KEYS, read the caller
# allowlist from a FILE (one key per line; blank lines and #-comments ignored).
# Mount the file into the container and point this at it to add/rotate keys
# without changing the env or rebuilding. Both sources merge.
# LOOM_API_KEYS_FILE=/data/loom_keys.txt

# OPTIONAL — where the gateway appends the JSONL moat corpus (one row per call).
# Point it at the mounted volume (see docker-compose.yml `volumes:`) so the
# corpus survives container restarts.
LOOM_PROXY_LOG_PATH=/data/proxy_calls.jsonl

# OPTIONAL — override the upstream Messages endpoint (default the real Anthropic
# API). Used to point at a compatible relay; not a per-request knob.
# LOOM_PROXY_UPSTREAM_URL=https://api.anthropic.com/v1/messages
