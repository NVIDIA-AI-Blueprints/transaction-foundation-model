# Copy to .env.gcp and adjust for your GCP project/quota.

GCP_PROJECT=level-mark-437714-b1
GCP_REGION=us-central1
GCP_ZONE=us-central1-f

# A100 40GB default because this project currently has A100 quota in us-central1.
# Use a2-ultragpu-1g for A100 80GB only after NVIDIA_A100_80GB_GPUS quota is approved.
# Use g2-standard-24 for a lower-cost 2x L4 exploratory box.
GCP_MACHINE_TYPE=a2-highgpu-1g
GCP_INSTANCE=tfm-gpu-notebook
GCP_BUCKET=level-mark-437714-b1-tfm-gpu-artifacts

NOTEBOOK_IMAGE=nvcr.io/nvidia/nemo:25.09.01
GPU_TEST_IMAGE=nvidia/cuda:12.4.1-base-ubuntu22.04
JUPYTER_PORT=8888
JUPYTER_TOKEN=tfm-dev
